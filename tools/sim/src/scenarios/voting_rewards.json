{
  "name": "voting_rewards",
  "description": "Voting-rewards epoch/claim lifecycle on contracts/voting-rewards (admin = governor, 20-ledger epochs, epoch 0 = ledgers 1..21): fund the pool, vote during epoch 0, roll the epoch once end_ledger passes, publish a Merkle root for the closed epoch, then claim against it with proofs. Pins the ordering constraints -- claiming before a root is published (EpochNotFinalized), publishing or rolling before an epoch ends (EpochNotEnded), publishing more than the pool holds (InsufficientPool), re-publishing a root (EpochAlreadyFinalized, write-once) -- plus double claim (AlreadyClaimed) and both forms of overclaim: a voter claiming more than their own leaf (InvalidProof) and an admin-supplied root whose leaves sum past the epoch's allocation (EpochOverclaimed).",
  "seed": 10,
  "governor_settings": {
    "voting_delay": 1,
    "voting_period": 10,
    "quorum_numerator": 10,
    "proposal_threshold": 100,
    "vote_type": "Extended",
    "proposal_grace_period": 1000,
    "max_calldata_size": 10000,
    "proposal_cooldown": 0,
    "max_proposals_per_period": 5,
    "proposal_period_duration": 10000
  },
  "actors": [
    { "name": "treasury", "initial_balance": 0, "delegate_to": null, "role": "TokenHolder" },
    { "name": "alice", "initial_balance": 1000, "delegate_to": null, "role": "Proposer" },
    { "name": "bob", "initial_balance": 500, "delegate_to": null, "role": "TokenHolder" }
  ],
  "steps": [
    { "type": "ExpectCurrentRewardsEpoch", "epoch_id": 0 },
    { "type": "ExpectRewardsEpoch", "epoch_id": 0, "start_ledger": 1, "end_ledger": 21, "total_reward_amount": 0, "claimed_amount": 0, "finalized": false, "description": "initialize opened epoch 0 at genesis" },
    { "type": "FundRewardsPool", "actor": "treasury", "amount": 10000 },
    { "type": "ExpectAvailableRewardsPool", "amount": 10000 },

    { "type": "Propose", "actor": "alice", "targets": ["target"], "fn_names": ["noop"], "description": "Proposal voted on during rewards epoch 0" },
    { "type": "AdvanceLedger", "ledgers": 2, "description": "ledger 3" },
    { "type": "ExpectState", "proposal_id": 1, "expected_state": "Active" },
    { "type": "Vote", "actor": "alice", "proposal_id": 1, "support": "For", "description": "1000 voting power cast in epoch 0" },
    { "type": "Vote", "actor": "bob", "proposal_id": 1, "support": "Against", "description": "500 voting power cast in epoch 0" },

    { "type": "ClaimReward", "actor": "alice", "epoch_id": 0, "amount": 1000, "description": "claim before any root is published" },
    { "type": "ExpectError", "step_index": 9, "expected_error": "Error(Contract, #8)" },
    { "type": "PublishRewardsRoot", "epoch_id": 0, "total_reward_amount": 1500, "allocations": [{ "actor": "alice", "amount": 1000 }, { "actor": "bob", "amount": 500 }], "description": "early publish: epoch 0 ends at ledger 21, it is ledger 3" },
    { "type": "ExpectError", "step_index": 11, "expected_error": "Error(Contract, #6)" },
    { "type": "StartNextRewardsEpoch", "description": "early roll: epoch 0 has not ended" },
    { "type": "ExpectError", "step_index": 13, "expected_error": "Error(Contract, #6)" },
    { "type": "ExpectRewardsEpoch", "epoch_id": 0, "start_ledger": 1, "end_ledger": 21, "total_reward_amount": 0, "claimed_amount": 0, "finalized": false, "description": "the rejected publish left epoch 0 untouched" },

    { "type": "AdvanceLedger", "ledgers": 18, "description": "ledger 21 == epoch 0's end_ledger" },
    { "type": "StartNextRewardsEpoch" },
    { "type": "ExpectCurrentRewardsEpoch", "epoch_id": 1 },
    { "type": "ExpectRewardsEpoch", "epoch_id": 1, "start_ledger": 21, "end_ledger": 41, "total_reward_amount": 0, "claimed_amount": 0, "finalized": false, "description": "epoch 1 starts at epoch 0's end_ledger, leaving no unrewardable gap" },

    { "type": "PublishRewardsRoot", "epoch_id": 0, "total_reward_amount": 20000, "allocations": [{ "actor": "alice", "amount": 1000 }, { "actor": "bob", "amount": 500 }], "description": "allocating more than the 10000 in the pool" },
    { "type": "ExpectError", "step_index": 20, "expected_error": "Error(Contract, #9)" },
    { "type": "PublishRewardsRoot", "epoch_id": 0, "total_reward_amount": 1500, "allocations": [{ "actor": "alice", "amount": 1000 }, { "actor": "bob", "amount": 500 }], "description": "1500 split in proportion to the voting power cast in epoch 0 (1000 : 500)" },
    { "type": "ExpectRewardsEpoch", "epoch_id": 0, "start_ledger": 1, "end_ledger": 21, "total_reward_amount": 1500, "claimed_amount": 0, "finalized": true },
    { "type": "ExpectAvailableRewardsPool", "amount": 8500, "description": "the 1500 is now committed to epoch 0" },
    { "type": "PublishRewardsRoot", "epoch_id": 0, "total_reward_amount": 1500, "allocations": [{ "actor": "alice", "amount": 1500 }], "description": "re-publishing epoch 0 with a different root" },
    { "type": "ExpectError", "step_index": 25, "expected_error": "Error(Contract, #7)" },

    { "type": "ClaimReward", "actor": "alice", "epoch_id": 0, "amount": 1000, "description": "valid claim against the original root, so the rejected re-publish did not replace it" },
    { "type": "ExpectRewardBalance", "actor": "alice", "balance": 1000 },
    { "type": "ExpectRewardClaimed", "actor": "alice", "epoch_id": 0, "claimed": true },
    { "type": "ClaimReward", "actor": "alice", "epoch_id": 0, "amount": 1000, "description": "double claim" },
    { "type": "ExpectError", "step_index": 30, "expected_error": "Error(Contract, #11)" },
    { "type": "ClaimReward", "actor": "bob", "epoch_id": 0, "amount": 600, "description": "overclaim: 600 with the proof for bob's 500 leaf" },
    { "type": "ExpectError", "step_index": 32, "expected_error": "Error(Contract, #12)" },
    { "type": "ExpectRewardClaimed", "actor": "bob", "epoch_id": 0, "claimed": false, "description": "the failed overclaim did not burn bob's claim" },
    { "type": "ClaimReward", "actor": "bob", "epoch_id": 0, "amount": 500 },
    { "type": "ExpectRewardBalance", "actor": "bob", "balance": 500 },
    { "type": "ExpectRewardsEpoch", "epoch_id": 0, "start_ledger": 1, "end_ledger": 21, "total_reward_amount": 1500, "claimed_amount": 1500, "finalized": true },
    { "type": "ExpectAvailableRewardsPool", "amount": 8500, "description": "claims pay out of epoch 0's allocation, not the unallocated pool" },

    { "type": "AdvanceLedger", "ledgers": 20, "description": "ledger 41 == epoch 1's end_ledger" },
    { "type": "StartNextRewardsEpoch" },
    { "type": "ExpectCurrentRewardsEpoch", "epoch_id": 2 },
    { "type": "PublishRewardsRoot", "epoch_id": 1, "total_reward_amount": 1000, "allocations": [{ "actor": "alice", "amount": 800 }, { "actor": "bob", "amount": 400 }], "description": "an inconsistent admin-supplied root: leaves sum to 1200 against a 1000 allocation" },
    { "type": "ExpectAvailableRewardsPool", "amount": 7500 },
    { "type": "ClaimReward", "actor": "alice", "epoch_id": 1, "amount": 800 },
    { "type": "ClaimReward", "actor": "bob", "epoch_id": 1, "amount": 400, "description": "overclaim: a valid proof, but 800 + 400 exceeds the epoch's 1000" },
    { "type": "ExpectError", "step_index": 45, "expected_error": "Error(Contract, #13)" },
    { "type": "ExpectRewardsEpoch", "epoch_id": 1, "start_ledger": 21, "end_ledger": 41, "total_reward_amount": 1000, "claimed_amount": 800, "finalized": true },
    { "type": "ExpectRewardClaimed", "actor": "bob", "epoch_id": 1, "claimed": false },
    { "type": "ExpectRewardBalance", "actor": "alice", "balance": 1800 },
    { "type": "ExpectRewardBalance", "actor": "bob", "balance": 500 },
    { "type": "ExpectAvailableRewardsPool", "amount": 7500, "description": "balance 7700 minus epoch 1's unclaimed 200" }
  ]
}
