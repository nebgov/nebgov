{
  "name": "liquidity",
  "description": "Protocol-owned liquidity lifecycle on contracts/liquidity's constant-product pool: add -> add -> swap -> fee update -> swap -> remove -> remove. After every step it asserts exact reserves, LP shares and pool-asset balances, plus the product invariant (reserve_a * reserve_b per LP share never decreases; it strictly grows on a fee-charging swap because the fee stays in the pool). Also pins that a second deposit is credited only the ratio-required B amount, that a fee above MAX_FEE_BPS is rejected, and that fee accrual is conserved: the 934 units the trader lost to the curve and fees are exactly what the two LPs withdraw above their deposits (dao +623, lp +311).",
  "seed": 9,
  "governor_settings": {
    "voting_delay": 1,
    "voting_period": 5,
    "quorum_numerator": 10,
    "proposal_threshold": 500,
    "vote_type": "Simple",
    "proposal_grace_period": 1000,
    "max_calldata_size": 10000,
    "proposal_cooldown": 50,
    "max_proposals_per_period": 10,
    "proposal_period_duration": 10000
  },
  "actors": [
    { "name": "dao", "initial_balance": 0, "delegate_to": null, "role": "TokenHolder" },
    { "name": "lp", "initial_balance": 0, "delegate_to": null, "role": "TokenHolder" },
    { "name": "trader", "initial_balance": 0, "delegate_to": null, "role": "TokenHolder" }
  ],
  "steps": [
    { "type": "CreateLiquidityPool", "fee_bps": 30, "description": "governor registers the A/B pool at a 0.30% fee" },
    { "type": "ExpectPool", "reserve_a": 0, "reserve_b": 0, "total_lp_supply": 0, "fee_bps": 30 },
    { "type": "MintPoolTokens", "actor": "dao", "amount_a": 100000, "amount_b": 100000 },
    { "type": "MintPoolTokens", "actor": "lp", "amount_a": 50000, "amount_b": 55000 },
    { "type": "MintPoolTokens", "actor": "trader", "amount_a": 10000, "amount_b": 20000 },

    { "type": "AddLiquidity", "actor": "dao", "amount_a": 100000, "amount_b": 100000, "description": "first deposit: LP shares minted 1:1 with the A side" },
    { "type": "ExpectPool", "reserve_a": 100000, "reserve_b": 100000, "total_lp_supply": 100000, "fee_bps": 30 },
    { "type": "ExpectLpShares", "actor": "dao", "lp_tokens": 100000 },
    { "type": "ExpectPoolInvariant" },
    { "type": "ExpectPoolTokenBalance", "actor": "dao", "balance_a": 0, "balance_b": 0 },

    { "type": "AddLiquidity", "actor": "lp", "amount_a": 50000, "amount_b": 55000, "description": "second deposit offers 55000 B as a maximum; only the ratio-required 50000 is credited, and shares are minted pro rata (50000 * 100000 / 100000)" },
    { "type": "ExpectPool", "reserve_a": 150000, "reserve_b": 150000, "total_lp_supply": 150000, "fee_bps": 30 },
    { "type": "ExpectLpShares", "actor": "lp", "lp_tokens": 50000 },
    { "type": "ExpectPoolTokenBalance", "actor": "lp", "balance_a": 0, "balance_b": 5000 },
    { "type": "ExpectPoolInvariant", "description": "existing LP (dao) not diluted by the second deposit" },

    { "type": "Swap", "actor": "trader", "asset_in": "A", "amount_in": 10000, "description": "out = 10000 * 150000 / 160000 = 9375; fee = 9375 * 30 / 10000 = 28; trader receives 9347" },
    { "type": "ExpectPool", "reserve_a": 160000, "reserve_b": 140653, "total_lp_supply": 150000, "fee_bps": 30 },
    { "type": "ExpectPoolInvariant", "expect_growth": true, "description": "k 22500000000 -> 22504480000: the retained fee grows the product" },
    { "type": "ExpectPoolTokenBalance", "actor": "trader", "balance_a": 0, "balance_b": 29347 },

    { "type": "UpdatePoolFee", "fee_bps": 100, "description": "governor raises the fee to 1.00%" },
    { "type": "ExpectPool", "reserve_a": 160000, "reserve_b": 140653, "total_lp_supply": 150000, "fee_bps": 100 },
    { "type": "UpdatePoolFee", "fee_bps": 1001, "description": "above MAX_FEE_BPS (1000) -- must be rejected with FeeTooHigh" },
    { "type": "ExpectError", "step_index": 21, "expected_error": "Error(Contract, #10)" },
    { "type": "ExpectPool", "reserve_a": 160000, "reserve_b": 140653, "total_lp_supply": 150000, "fee_bps": 100, "description": "rejected update left the pool untouched" },

    { "type": "Swap", "actor": "trader", "asset_in": "B", "amount_in": 20000, "description": "reverse direction at the new fee: out = 20000 * 160000 / 160653 = 19918; fee = 19918 * 100 / 10000 = 199; trader receives 19719" },
    { "type": "ExpectPool", "reserve_a": 140281, "reserve_b": 160653, "total_lp_supply": 150000, "fee_bps": 100 },
    { "type": "ExpectPoolInvariant", "expect_growth": true, "description": "k 22504480000 -> 22536563493" },
    { "type": "ExpectPoolTokenBalance", "actor": "trader", "balance_a": 19719, "balance_b": 9347 },

    { "type": "RemoveLiquidity", "actor": "lp", "lp_tokens": 50000, "description": "pro-rata exit: A = 50000 * 140281 / 150000 = 46760, B = 50000 * 160653 / 150000 = 53551" },
    { "type": "ExpectPool", "reserve_a": 93521, "reserve_b": 107102, "total_lp_supply": 100000, "fee_bps": 100 },
    { "type": "ExpectLpShares", "actor": "lp", "lp_tokens": 0 },
    { "type": "ExpectLpShares", "actor": "dao", "lp_tokens": 100000 },
    { "type": "ExpectPoolInvariant", "description": "rounding on withdrawal favours the pool, so the remaining LP (dao) is not diluted" },
    { "type": "ExpectPoolTokenBalance", "actor": "lp", "balance_a": 46760, "balance_b": 58551, "description": "deposited 50000 A + 50000 B, withdrew 46760 A + 53551 B: +311 in accrued fees and price movement" },

    { "type": "RemoveLiquidity", "actor": "dao", "lp_tokens": 100000, "description": "last LP drains the pool" },
    { "type": "ExpectPool", "reserve_a": 0, "reserve_b": 0, "total_lp_supply": 0, "fee_bps": 100 },
    { "type": "ExpectLpShares", "actor": "dao", "lp_tokens": 0 },
    { "type": "ExpectPoolInvariant", "description": "zero LP supply must mean zero reserves -- nothing stranded" },
    { "type": "ExpectPoolTokenBalance", "actor": "dao", "balance_a": 93521, "balance_b": 107102, "description": "deposited 100000 A + 100000 B, withdrew 93521 A + 107102 B: +623" }
  ]
}
